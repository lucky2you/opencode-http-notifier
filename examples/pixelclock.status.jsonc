// opencode-http-notifier → PixelClock status-dot example.
//
// Each OpenCode session becomes one status dot on the device, keyed by a stable
// short hash of its real session ID (`{sessionKey}`), so the dot for a session
// stays the same across that session's life.
//
// No event normalization: every raw OpenCode event type keeps its own identity
// and is matched individually. You use wildcard patterns (`session.*`) and a
// catch-all (`*`) to keep the config short without enumerating every event.
// The two "idle-looking" events the device cares about are now distinct:
//   - `session.execution.succeeded`  task finished  -> steady
//   - `session.idle`                 waiting for input -> blinks
//
// Mapping to the PixelClock API (see the device /api doc):
//   POST http://192.168.0.91:8081/status  {"app_id","active","color","blink_hz","timeout"}
//
// Paste the `options` object below into your opencode config:
// {
//   "plugins": [{
//     "package": "opencode-http-notifier",
//     "options": { ... }
//   }]
// }
{
  "url": "http://192.168.0.91:8081/status",
  "payload": "custom",
  "emitRepeatedStates": false,
  "debounceMs": 300,
  "throttleMs": 800,
  "retries": 2,
  "timeoutMs": 2000,
  "successStatus": 300,

  // Only session lifecycle events reach the device. Add more wildcards here if
  // you want permission events etc. included.
  "notifyOn": ["session.*"],

  // Events that need a human blink; ones with nothing to do stay steady.
  // `timeout` (ms) controls how long the dot stays before the device drops it
  // on its own; omitted states fall through to "session.*" below.
  "events": {
    "session.execution.started":   { "body": { "app_id": "{sessionKey}", "color": "amber", "timeout": 600000 } },
    "session.step.started":        { "body": { "app_id": "{sessionKey}", "color": "amber", "timeout": 600000 } },
    "session.execution.succeeded": { "body": { "app_id": "{sessionKey}", "color": "green", "timeout": 600000 } },
    "session.retry.scheduled":     { "body": { "app_id": "{sessionKey}", "color": "amber", "blink_hz": 4, "timeout": 600000 } },
    "session.error":               { "body": { "app_id": "{sessionKey}", "color": "red", "blink_hz": 1, "timeout": 600000 } },
    "session.execution.failed":    { "body": { "app_id": "{sessionKey}", "color": "red", "blink_hz": 1, "timeout": 600000 } },
    "session.idle":                { "body": { "app_id": "{sessionKey}", "color": "green", "blink_hz": 2, "timeout": 600000 } },
    "session.created":             { "body": { "app_id": "{sessionKey}", "color": "cyan", "timeout": 600000 } },

    // Catch-all default for any other session.* event: steady white dot.
    "session.*":                   { "body": { "app_id": "{sessionKey}", "color": "white", "timeout": 600000 } }
  }
}