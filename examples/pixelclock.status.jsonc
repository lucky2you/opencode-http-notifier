// opencode-http-notifier → PixelClock status-dot example.
//
// Each OpenCode session becomes one status dot on the device, keyed by a stable
// short hash of its real session ID (`{sessionKey}`), so the dot for a session
// stays the same across that session's life.
//
// No event normalization: every raw OpenCode event type keeps its own identity
// and is matched individually. You use wildcard patterns (`session.*`) and a
// catch-all (`*`) to keep the config short without enumerating every event.
//
// IMPORTANT (OpenCode V2): v2 does not emit a separate `session.idle` event.
// When a turn finishes and the session waits for your next input, v2 fires
// `session.execution.succeeded` (the sequence is `session.step.ended` ->
// `session.execution.succeeded`). So on V2 "waiting for input" and "task
// finished" are the SAME event — we style that single signal as an amber blink
// (needs a human). Only V1 historically emitted a distinct `session.idle`
// ("waiting for input"); the mapping below also keeps `session.idle` for V1.
//
// Live mapping to the PixelClock device:
//   - `session.step.started`         busy / working     -> steady cyan
//   - `session.execution.succeeded`  waiting for input  -> AMBER BLINK
//   - `session.execution.started`    (older V2 busy)    -> steady blue
//   - `session.created`              brand-new session  -> steady white
//   - `session.retry.scheduled`      retrying           -> magenta blink
//   - `session.error`/`failed`       blew up            -> red blink
//   - `session.idle`                 V1 waiting for input -> amber blink
//
// Mapping to the PixelClock API (see the device /api doc):
//   POST http://192.168.0.91:8081/status  {"app_id","active","color","blink_hz","timeout"}
//
// Paste the `options` object below into your opencode config:
// {
//   "plugins": [{
//     "package": "opencode-http-notifier",
//     "options": { ... }
//   }]
// }
{
  "url": "http://192.168.0.91:8081/status",
  "payload": "custom",
  "emitRepeatedStates": false,
  "debounceMs": 300,
  "throttleMs": 800,
  "retries": 2,
  "timeoutMs": 2000,
  "successStatus": 300,

  // Only session lifecycle events reach the device. Add more wildcards here if
  // you want permission events etc. included.
  "notifyOn": ["session.*"],

  // When opencode stops gracefully, remove every status dot this instance lit:
  // send `active:false` for each distinct `app_id` we posted to. (A hard kill of
  // the process can't run this — those dots persist until the device clears
  // them or they're overwritten.)
  "cleanup": {
    "onClose": {
      "field": "app_id",
      "remove": { "app_id": "{key}", "active": false }
    }
  },

  // Busy / retrying / starting states must NOT disappear on a long timeout, so
  // they use `timeout: 0` = resident until a new request overwrites or removes
  // the dot. Only the "waiting for input" states (`session.execution.succeeded`
  // on V2, `session.idle` on V1) use a finite `timeout` (600000ms = 10 minutes)
  // so the device clears them on its own. Omitted states fall through to the
  // "session.*" default below.
  //
  // Colour legend (blink = needs a human; steady = nothing to do):
  //   step.started            cyan  — busy / working (steady)
  //   execution.started       blue  — older V2 busy signal (steady)
  //   execution.succeeded     amber — V2: turn done, waiting for input (BLINK)
  //   created                 white — brand-new session (steady)
  //   retry.scheduled         magenta 0xF81F — retrying, keep an eye (blink)
  //   error / failed          red   — blew up, needs you (blink)
  //   idle (V1 only)          amber — waiting for your input (blink)
  "events": {
    "session.step.started":          { "body": { "app_id": "{sessionKey}", "color": "cyan",  "timeout": 0 } },
    "session.execution.started":     { "body": { "app_id": "{sessionKey}", "color": "blue",  "timeout": 0 } },
    "session.execution.succeeded":   { "body": { "app_id": "{sessionKey}", "color": "amber", "blink_hz": 2, "timeout": 600000 } },
    "session.retry.scheduled":       { "body": { "app_id": "{sessionKey}", "color": 63455,   "blink_hz": 4, "timeout": 0 } },
    "session.error":                 { "body": { "app_id": "{sessionKey}", "color": "red",   "blink_hz": 1, "timeout": 0 } },
    "session.execution.failed":      { "body": { "app_id": "{sessionKey}", "color": "red",   "blink_hz": 1, "timeout": 0 } },
    "session.idle":                  { "body": { "app_id": "{sessionKey}", "color": "amber", "blink_hz": 2, "timeout": 600000 } },
    "session.created":               { "body": { "app_id": "{sessionKey}", "color": "white", "timeout": 0 } },

    // Catch-all default for any other session.* event: steady white, resident.
    "session.*":                     { "body": { "app_id": "{sessionKey}", "color": "white", "timeout": 0 } }
  }
}